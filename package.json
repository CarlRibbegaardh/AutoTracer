{
  "private": true,
  "author": "Carl Ribbegårdh",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "dev:microfrontend": "turbo run dev --filter=example-microfrontend-host --filter=example-microfrontend-remote1 --filter=example-microfrontend-remote2",
    "dev:islands": "turbo run dev --filter=example-islands-loader --filter=example-islands-react1 --filter=example-islands-react2",
    "build:islands": "turbo run build --filter=example-islands-react1 --filter=example-islands-react2",
    "preview:islands": "turbo run preview --filter=example-islands-loader --filter=example-islands-react1 --filter=example-islands-react2",
    "preview:microfrontend": "turbo run preview --filter=example-microfrontend-host --filter=example-microfrontend-remote1 --filter=example-microfrontend-remote2",
    "lint": "turbo run lint --concurrency=1 --continue=never",
    "lint:fix": "turbo run lint --concurrency=1 --continue=never -- --fix",
    "test": "turbo run test --concurrency=1 --continue=never",
    "test:e2e": "turbo run test:e2e --concurrency=1 --continue=never",
    "test:e2e:hmr": "turbo run test:e2e:hmr --concurrency=1 --continue=never",
    "test:e2e:preview": "turbo run test:e2e:preview --concurrency=1 --continue=never",
    "verify": "pnpm run build && pnpm run lint:fix && pnpm run test && pnpm run test:e2e && pnpm run test:e2e:hmr && pnpm run test:e2e:preview",
    "verify:force": "pnpm run build --force && pnpm run lint --force && pnpm run test --force && pnpm run test:e2e --force && pnpm run test:e2e:hmr --force && pnpm run test:e2e:preview --force",
    "list-packages": "pnpm list --depth 0 --json -r | node ./tools/list-packages.cjs",
    "list-packages-duplicates": "pnpm list --depth 0 --json -r | node ./tools/list-packages-duplicates.cjs",
    "plato": "pnpm plato:run && pnpm plato:info",
    "plato:run": "powershell -File .\\metrics\\ts-plato\\run-all.ps1",
    "plato:info": "node .\\metrics\\ts-plato\\summary.cjs",
    "knip:packages": "knip",
    "publish-auto-tracer-dashboard": "pnpm --filter @autotracer/dashboard publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-flow": "pnpm --filter @autotracer/flow publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-filter-utils": "pnpm --filter @autotracer/filter-utils publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-plugin-babel-flow": "pnpm --filter @autotracer/plugin-babel-flow publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-plugin-vite-flow": "pnpm --filter @autotracer/plugin-vite-flow publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-network": "pnpm --filter @autotracer/network publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-plugin-vite-network": "pnpm --filter @autotracer/plugin-vite-network publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-react18": "pnpm --filter @autotracer/react18 publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-react19": "pnpm --filter @autotracer/react19 publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-inject-react18": "pnpm --filter @autotracer/inject-react18 publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-inject-react19": "pnpm --filter @autotracer/inject-react19 publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-plugin-babel-react18": "pnpm --filter @autotracer/plugin-babel-react18 publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-plugin-babel-react19": "pnpm --filter @autotracer/plugin-babel-react19 publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-plugin-vite-react18": "pnpm --filter @autotracer/plugin-vite-react18 publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-plugin-vite-react19": "pnpm --filter @autotracer/plugin-vite-react19 publish --tag latest --no-git-checks --access=public",
    "publish-auto-tracer-logger": "pnpm --filter @autotracer/logger publish --tag latest --no-git-checks --access=public",
    "publish-suite": "pnpm verify && pnpm run publish-auto-tracer-dashboard && pnpm run publish-auto-tracer-react18 && pnpm run publish-auto-tracer-react19 && pnpm run publish-auto-tracer-inject-react18 && pnpm run publish-auto-tracer-inject-react19 && pnpm run publish-auto-tracer-plugin-vite-react18 && pnpm run publish-auto-tracer-plugin-vite-react19 && pnpm run publish-auto-tracer-logger && pnpm run publish-auto-tracer-flow && pnpm run publish-auto-tracer-plugin-babel-flow && pnpm run publish-auto-tracer-plugin-vite-flow && pnpm run publish-auto-tracer-network && pnpm run publish-auto-tracer-plugin-vite-network && pnpm run publish-auto-tracer-filter-utils && pnpm run publish-auto-tracer-plugin-babel-react18 && pnpm run publish-auto-tracer-plugin-babel-react19"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.1.0",
    "knip": "^5.0.0",
    "turbo": "^2.6.1",
    "vitest": "4.0.18"
  }
}
