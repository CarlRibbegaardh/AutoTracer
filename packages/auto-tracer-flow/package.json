{
  "name": "@autotracer/flow",
  "version": "1.0.0-alpha.55",
  "description": "Function flow tracing runtime for automatic enter/exit tracking",
  "author": "Carl Ribbegårdh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CarlRibbegaardh/AutoTracer"
  },
  "bugs": {
    "url": "https://github.com/CarlRibbegaardh/AutoTracer/issues"
  },
  "homepage": "https://github.com/CarlRibbegaardh/AutoTracer",
  "type": "module",
  "dependencies": {
    "@autotracer/filter-utils": "workspace:*",
    "@autotracer/logger": "workspace:*",
    "deepmerge": "^4.3.1",
    "safe-stable-stringify": "^2.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-sort-exports": "^0.9.1",
    "jsdom": "^24.1.0",
    "rimraf": "^6.0.1",
    "rollup": "4.61.1",
    "typescript": "~5.5.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "tsc",
    "prebuild": "pnpm run clean",
    "postbuild": "tsc --project ./tests/tsconfig.json --noEmit",
    "clean": "rimraf dist coverage",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --mode ci --coverage"
  },
  "files": [
    "dist",
    "package.json",
    "tsconfig.json",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./build-utils": {
      "import": "./dist/build-utils.js",
      "types": "./dist/build-utils.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    },
    "./package.json": "./package.json"
  }
}
