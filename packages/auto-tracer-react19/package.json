{
  "name": "@autotracer/react19",
  "version": "1.0.0-alpha.55",
  "description": "Tracing library to detect rerender causes and state changes",
  "author": "Carl Ribbegårdh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CarlRibbegaardh/AutoTracer"
  },
  "bugs": {
    "url": "https://github.com/CarlRibbegaardh/AutoTracer/issues"
  },
  "homepage": "https://github.com/CarlRibbegaardh/AutoTracer",
  "type": "module",
  "dependencies": {
    "@autotracer/filter-utils": "workspace:*",
    "@autotracer/logger": "workspace:*",
    "deepmerge": "^4.3.1",
    "ramda": "^0.32.0",
    "safe-stable-stringify": "^2.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@types/node": "^22.12.0",
    "@types/ramda": "^0.31.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/typescript6": "~6.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint-plugin-local-rules": "workspace:*",
    "eslint-plugin-sort-exports": "^0.9.1",
    "flatted": "^3.3.3",
    "jsdom": "^24.1.0",
    "oxlint": "1.77.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rimraf": "^6.0.1",
    "rollup": "4.61.1",
    "typescript": "~7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && pnpm run check:typescript6 && vite build && tsc --project tsconfig.build-utils.json",
    "check:typescript6": "tsc6 --project tsconfig.typescript6.json",
    "prebuild": "pnpm run clean",
    "postbuild": "tsc --project ./tests/tsconfig.json --noEmit && pnpm run check:typescript6:consumer",
    "check:typescript6:consumer": "tsc6 --project tests/typescript6-consumer/tsconfig.json",
    "clean": "rimraf dist coverage",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "test": "vitest run",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --mode ci --coverage"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "files": [
    "dist",
    "package.json",
    "tsconfig.json",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./build-utils": {
      "import": "./dist/build-utils.js",
      "types": "./dist/build-utils.d.ts"
    },
    "./dist/index.umd.js": "./dist/index.umd.js",
    "./package.json": "./package.json"
  }
}
