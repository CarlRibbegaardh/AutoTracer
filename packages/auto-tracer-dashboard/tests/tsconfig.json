{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "..",
    "paths": {
      "@src/*": [
        "../src/*"
      ],
      "@tests/*": [
        "./*"
      ]
    }
  },
  "include": [
    "../src",
    "**/*.ts",
    "**/*.tsx"
  ]
}
