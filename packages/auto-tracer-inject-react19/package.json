{
  "name": "@autotracer/inject-react19",
  "version": "1.0.0-alpha.55",
  "description": "Shared AST transform logic for auto-injecting useReactTracer",
  "author": "Carl Ribbegårdh",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run check:typescript6 && pnpm run build:esm && pnpm run build:cjs",
    "check:typescript6": "tsc6 --project tsconfig.typescript6.json",
    "prebuild": "pnpm run clean",
    "build:esm": "tsc --project tsconfig.esm.json && rollup -c rollup.config.esm.js",
    "build:cjs": "tsc --project tsconfig.cjs.json && rollup -c rollup.config.cjs.js",
    "clean": "rimraf dist .build coverage",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postbuild": "tsc --project ./tests/tsconfig.json --noEmit && pnpm run check:typescript6:consumer",
    "check:typescript6:consumer": "tsc6 --project tests/typescript6-consumer/tsconfig.json",
    "_test": "vitest",
    "_test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@babel/generator": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0"
  },
  "devDependencies": {
    "@autotracer/filter-utils": "workspace:*",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@types/babel__generator": "^7.6.0",
    "@types/babel__traverse": "^7.18.0",
    "@types/node": "^22.12.0",
    "@typescript/typescript6": "~6.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^24.1.0",
    "oxlint": "1.77.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.61.1",
    "typescript": "~7.0.2",
    "vitest": "4.1.10"
  },
  "sideEffects": false
}
