{
  "name": "@autotracer/plugin-babel-flow",
  "version": "1.0.0-alpha.55",
  "description": "Babel plugin for automatic function flow tracing with try/catch/finally injection",
  "author": "Carl Ribbegårdh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CarlRibbegaardh/AutoTracer"
  },
  "bugs": {
    "url": "https://github.com/CarlRibbegaardh/AutoTracer/issues"
  },
  "homepage": "https://github.com/CarlRibbegaardh/AutoTracer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "prebuild": "pnpm run clean",
    "postbuild": "tsc --project ./tests/tsconfig.json --noEmit",
    "clean": "rimraf dist coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/template": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "@autotracer/filter-utils": "workspace:*",
    "@babel/core": "^7.25.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/babel__core": "^7.20.0",
    "@types/babel__template": "^7.4.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^4.0.18",
    "rimraf": "^6.0.1",
    "rollup": "^4.61.1",
    "typescript": "~5.5.3",
    "vitest": "^4.0.18"
  }
}
