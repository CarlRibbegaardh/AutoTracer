{
  "name": "@autotracer/react19-proof",
  "private": true,
  "version": "1.0.0-alpha.55",
  "author": "Carl Ribbegårdh",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && pnpm run check:typescript6",
    "check:typescript6": "tsc6 --project tsconfig.typescript6.json",
    "prebuild": "pnpm run clean",
    "postbuild": "tsc --project ./tests/tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.49.0",
    "react-redux": "^9.0.0",
    "reselect": "^5.0.0"
  },
  "devDependencies": {
    "@autotracer/react19": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/typescript6": "~6.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^24.1.0",
    "oxlint": "1.77.0",
    "rimraf": "^6.0.1",
    "rollup": "4.61.1",
    "typescript": "~7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
