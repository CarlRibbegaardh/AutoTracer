{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "..",
    "paths": {
      "@src/*": [
        "../src/*"
      ],
      "@tests/*": [
        "./*"
      ]
    },
    "noUnusedParameters": false
  },
  "include": [
    "../src",
    "."
  ],
  "exclude": []
}
