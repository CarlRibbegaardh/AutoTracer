{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "outputLogs": "new-only"
    },
    "dev": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputLogs": "new-only"
    },
    "test": {
      "outputLogs": "new-only"
    },
    "test:e2e": {
      "outputLogs": "new-only"
    },
    "test:e2e:hmr": {
      "outputLogs": "new-only",
      "cache": false
    },
    "test:e2e:preview": {
      "dependsOn": [
        "build"
      ],
      "outputLogs": "new-only"
    },
    "clean": {
      "cache": false
    }
  }
}
